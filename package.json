{
  "name": "fastapi-full-stack-template",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter frontend dev",
    "build": "bun run --filter frontend build",
    "typecheck": "bun run --filter frontend typecheck && bun run --filter @kds/ui typecheck",
    "format": "biome check --write --linter-enabled=false .",
    "format:check": "biome check --linter-enabled=false .",
    "lint": "biome lint .",
    "lint:check": "biome check .",
    "storybook": "bun run --filter frontend storybook",
    "build-storybook": "bun run --filter frontend build-storybook",
    "test:unit": "bun run --filter frontend test:unit",
    "test:storybook": "bun run --filter frontend test:storybook",
    "check:deps": "knip",
    "test": "bun run --filter frontend test",
    "test:ui": "bun run --filter frontend test:ui",
    "email:dev": "bun run --filter emails dev",
    "email:export": "bun run --filter emails export"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "knip": "6.32.2"
  }
}

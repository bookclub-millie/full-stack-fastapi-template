{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write --linter-enabled=false ./",
    "format:check": "biome check --linter-enabled=false ./",
    "lint": "biome lint ./",
    "lint:check": "biome check ./",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:unit": "vitest run --coverage",
    "test:storybook": "vitest run --config .storybook/vitest.config.ts",
    "storybook:preview": "http-server storybook-static -p 6006 -a 127.0.0.1 --silent",
    "preview": "vite preview",
    "generate-client": "openapi-ts",
    "test": "bunx playwright test",
    "test:ui": "bunx playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@kds/ui": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^9.2.4",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/builder-vite": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "^18.0.4",
    "http-server": "14.1.1",
    "storybook": "10.5.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "4.1.10"
  }
}
